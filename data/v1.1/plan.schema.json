        },
        "base_passive": {
          "maxLength": 150,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:-]+$",
          "title": "Base Passive",
          "type": "string"
        },
        "display": {
          "$ref": "#/$defs/Display"
        }
      },
      "required": [
        "kind",
        "id",
        "base_passive"
      ],
      "title": "PassiveCopy",
      "type": "object"
