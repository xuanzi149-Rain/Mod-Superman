    "TriggerEffect": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "trigger",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 150,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:-]+$",
          "title": "Id",
          "type": "string"
