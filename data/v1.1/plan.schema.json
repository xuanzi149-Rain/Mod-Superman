  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1-draft-4",
      "default": "1.1-draft-4",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "enum": [
        "modify_existing",
        "create_new"
      ],
      "title": "Mode",
      "type": "string"
    },
    "base_equipment": {
      "maxLength": 150,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:-]+$",
      "title": "Base Equipment",
      "type": "string"
    },
    "user_goal": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "User Goal",
      "type": "string"
    },
    "display": {
      "$ref": "#/$defs/Display"
    },
    "parameters": {
      "$ref": "#/$defs/BaseParameters"
    },
    "effects": {
      "items": {
        "discriminator": {
          "mapping": {
            "bonus": "#/$defs/NativeBonus",
            "constant": "#/$defs/ConstantEffect",
            "grant_spell": "#/$defs/GrantedSpell",
            "independent_status": "#/$defs/IndependentStatus",
            "passive_copy": "#/$defs/PassiveCopy",
            "trigger": "#/$defs/TriggerEffect",
            "weapon_damage": "#/$defs/WeaponDamageBonus"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ConstantEffect"
          },
          {
            "$ref": "#/$defs/NativeBonus"
          },
          {
            "$ref": "#/$defs/WeaponDamageBonus"
          },
          {
            "$ref": "#/$defs/PassiveCopy"
          },
          {
            "$ref": "#/$defs/TriggerEffect"
          },
          {
            "$ref": "#/$defs/GrantedSpell"
          },
          {
            "$ref": "#/$defs/IndependentStatus"
          }
        ]
      },
      "maxItems": 30,
      "title": "Effects",
      "type": "array"
    },
    "removed_original_passives": {
      "items": {
        "maxLength": 150,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_:-]+$",
        "type": "string"
      },
      "maxItems": 30,
      "title": "Removed Original Passives",
      "type": "array"
    },
    "acquisition": {
      "anyOf": [
        {
          "maxLength": 150,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquisition"
    },
    "appearance_equipment": {
      "anyOf": [
        {
          "maxLength": 150,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Appearance Equipment"
    },
    "template_behavior": {
      "default": "reject_special",
