    "SpellSlotCost": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "maximum": 6,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "amount": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "level"
      ],
      "title": "SpellSlotCost",
      "type": "object"
