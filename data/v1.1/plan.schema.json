        "status_draft_id": {
          "anyOf": [
            {
              "maxLength": 150,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
