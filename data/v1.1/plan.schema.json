          "title": "Condition",
          "type": "string"
        },
        "target": {
          "enum": [
            "self",
            "target"
          ],
          "title": "Target",
          "type": "string"
        },
        "action": {
          "default": "status",
          "enum": [
            "status",
            "damage",
            "heal"
          ],
          "title": "Action",
          "type": "string"
