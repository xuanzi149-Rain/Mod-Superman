              "type": "null"
            }
          ],
          "default": null,
          "title": "Dice"
        },
        "damage_type": {
          "anyOf": [
            {
              "enum": [
                "Slashing",
                "Piercing",
                "Bludgeoning",
                "Acid",
                "Cold",
                "Fire",
                "Force",
                "Lightning",
                "Necrotic",
                "Poison",
                "Psychic",
                "Radiant",
                "Thunder"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Damage Type"
        },
        "status_ref": {
          "anyOf": [
            {
              "maxLength": 150,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Ref"
