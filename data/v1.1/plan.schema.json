      "required": [
        "kind",
        "id",
        "event",
        "condition",
        "target",
        "duration_turns"
      ],
      "title": "TriggerEffect",
      "type": "object"
    },
    "WeaponDamageBonus": {
      "additionalProperties": false,
      "description": "Equipped passive affecting the wearer's weapons, not the source item.",
      "properties": {
        "kind": {
          "const": "weapon_damage",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 150,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:-]+$",
          "title": "Id",
          "type": "string"
        },
        "dice": {
          "pattern": "^(?:[1-9]|10)d(?:4|6|8|10|12|20)$",
          "title": "Dice",
          "type": "string"
        },
        "damage_type": {
          "enum": [
            "Slashing",
            "Piercing",
            "Bludgeoning",
            "Acid",
            "Cold",
            "Fire",
            "Force",
            "Lightning",
            "Necrotic",
            "Poison",
            "Psychic",
            "Radiant",
            "Thunder"
          ],
          "title": "Damage Type",
          "type": "string"
