# Copy to .env.local. Keep credentials on the server; never commit them.
MODEL_PROVIDER=bailian
MODEL_NAME=qwen3.7-plus
MODEL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_USE_SYSTEM_PROXY=0
# This endpoint needs a Token Plan dedicated key, not the former DeepSeek key.
BAILIAN_TOKEN_PLAN_API_KEY=
# For standard Bailian pay-as-you-go endpoints only:
DASHSCOPE_API_KEY=
# Optional legacy provider configuration (inactive while MODEL_PROVIDER=bailian).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_USE_SYSTEM_PROXY=0
